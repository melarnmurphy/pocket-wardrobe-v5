NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
PIPELINE_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_PREMIUM_UPGRADE_URL=
BILLING_PROVIDER=
BILLING_SYNC_SECRET=
ADMIN_EMAILS=

# Trend discovery: OpenRouter (Perplexity Sonar) is the default scout.
# SearXNG is failover if you run an instance. Grok and Tavily are later fallbacks.
OPENROUTER_API_KEY=
OPENROUTER_TREND_MODEL=perplexity/sonar
# Extraction + story naming. Default: discounted Solar Pro 4 (~$0.03/$0.12 per 1M).
# Other discounted JSON-capable options: qwen/qwen3-30b-a3b-instruct-2507, inclusionai/ling-3.0-flash
OPENROUTER_CHAT_MODEL=upstage/solar-pro4
SEARXNG_BASE_URL=
XAI_API_KEY=
XAI_TREND_MODEL=
TAVILY_API_KEY=

TRAFILATURA_SERVICE_URL=
CRAWL4AI_SERVICE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
